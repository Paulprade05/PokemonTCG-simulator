# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# claude local
.claude/
start.log

# Instantáneas antiguas del proyecto descomprimidas en la raíz (ramas
# feat-mobile-ux y feat-pwa-ios). Se conservan para consulta, pero no son
# código del proyecto: su trabajo de PWA y móvil ya está en la raíz.
/PokemonTCG-simulator-feat-*/
/PokemonTCG-simulator-feat-*.zip

# Ficheros de trabajo temporales de la sesión de mejoras (graduación, bazar,
# eras y precios). NO SE BORRAN —regla del dueño del repositorio— pero tampoco
# tienen por qué viajar a GitHub: son scripts de medición de usar y tirar.
# Si algún día se decide que alguno merece quedarse, se le quita el prefijo
# `_tmp-` y se le saca de aquí.
scripts/_tmp-*
/_depth.js
/_parse_tmp.js
