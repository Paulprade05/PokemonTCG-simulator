{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Instantáneas antiguas del proyecto (ramas feat-mobile-ux y feat-pwa-ios)
    // descomprimidas dentro de la raíz. Son copias completas, así que sin esto
    // el typecheck compila el proyecto tres veces.
    "PokemonTCG-simulator-feat-mobile-ux",
    "PokemonTCG-simulator-feat-pwa-ios"
  ]
}
